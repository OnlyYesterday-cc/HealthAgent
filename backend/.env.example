# App environment
APP_ENV=dev
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# Database: default SQLite for local dev; switch to postgres for docker
DATABASE_URL=sqlite:///./healthagent.db
# DATABASE_URL=postgresql+psycopg://health:health@postgres:5432/healthagent

# JWT
JWT_SECRET=please-change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# OCR: qwen (direct vision model), baidu (requires AK/SK), or paddle
OCR_ENGINE=qwen
BAIDU_OCR_AK=
BAIDU_OCR_SK=

# 通义千问 VL 作为 OCR 兜底复检（百度云识别缺字段时自动触发）
DASHSCOPE_API_KEY=
DASHSCOPE_VL_MODEL=qwen-vl-plus
DASHSCOPE_TIMEOUT=30.0
OCR_VLM_FALLBACK=false
# 视觉识别与兜底复检复用下方文字模型的接口、密钥和模型
OCR_VLM_USE_CHAT_CONFIG=true
# 视觉任务关闭思考；开启时使用文字模型配置的思考强度
OCR_VLM_ENABLE_THINKING=false

# --- 文字模型：Token Plan 专属 Key；留空时回退到 DASHSCOPE_API_KEY ---
DASHSCOPE_CHAT_API_KEY=
DASHSCOPE_CHAT_ENDPOINT=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1/chat/completions
DASHSCOPE_CHAT_MODEL=qwen3.8-flash
DASHSCOPE_REASONING_EFFORT=low
# --- 云端向量：DashScope，使用 DASHSCOPE_API_KEY；切换后需重建知识库 ---
EMBEDDING_PROVIDER=dashscope
DASHSCOPE_EMBEDDING_MODEL=qwen3.7-text-embedding-flash
DASHSCOPE_EMBEDDING_DIM=1024
LLM_TEMPERATURE=0.3
LLM_CACHE_DIR=.cache/llm-qwen3.7-text-embedding-flash-1024
RAG_KB_DB_PATH=storage/kb-qwen3.7-text-embedding-flash-1024.sqlite
RAG_TOP_K=5
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
DASHSCOPE_EMBEDDING_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1/embeddings
